@{
    ViewData["Title"] = "Tienda";
}
@model IEnumerable<PaginaBizu.Models.Product>

<!-- Google Fonts: Montserrat + Playfair Display para elegancia -->
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600&family=Playfair+Display&display=swap" rel="stylesheet" />

<style>
    body {
        font-family: 'Montserrat', sans-serif;
        background-color: #f5f5f5; /* Fondo muy suave */
        color: #181a1b; /* Gris muy oscuro para texto */
        margin: 0;
        padding: 0;
    }

    .container {
        max-width: 1200px;
        margin: 3rem auto;
        padding: 0 1rem;
    }

    /* Grid de productos con flex-wrap y gap */
    .row {
        display: flex;
        flex-wrap: wrap;
        gap: 1.5rem;
        justify-content: center;
    }

    .product-item {
        background-color: transparent; /* sin fondo */
        border: none; /* sin borde */
        box-shadow: none; /* sin sombra */
        width: 260px;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 0;
        cursor: pointer;
        text-align: center;
    }

        .product-item:hover {
            box-shadow: none;
            transform: none;
        }

        /* Imagen cuadrada uniforme, con object-fit contain para que no se recorte */
        .product-item img {
            width: 260px;
            height: 260px;
            object-fit: contain;
            border-radius: 8px;
            margin-bottom: 1rem;
            background-color: #fff; /* fondo blanco para que resalte */
        }

    /* Nombre producto */
    .product-name {
        font-family: 'Playfair Display', serif;
        font-weight: 600;
        font-size: 1.2rem;
        color: #181a1b;
        margin-bottom: 0.3rem;
        text-transform: capitalize;
    }

    /* Precio */
    .product-price {
        font-size: 0.9rem;
        color: #555555;
        margin-bottom: 1rem;
        font-weight: 400;
    }

    /* Botón ver más */
    .btn-vermas {
        background: none;
        border: 1.5px solid #181a1b;
        color: #181a1b;
        border-radius: 25px;
        padding: 0.5rem 2rem;
        font-weight: 600;
        font-family: 'Montserrat', sans-serif;
        text-decoration: none;
        transition: background-color 0.3s ease, color 0.3s ease;
        display: inline-block;
    }

        .btn-vermas:hover {
            background-color: #181a1b;
            color: #f5f5f5;
            text-decoration: none;
        }

    /* Buscador minimalista */
    .search-wrapper {
        max-width: 600px;
        margin: 0 auto 3rem;
        position: relative;
    }

        .search-wrapper input[type="text"] {
            width: 100%;
            padding: 14px 50px 14px 20px;
            font-size: 1rem;
            border-radius: 40px;
            border: 1.5px solid #ccc;
            background-color: #fff;
            font-family: 'Montserrat', sans-serif;
            transition: border-color 0.3s ease, box-shadow 0.3s ease;
        }

            .search-wrapper input[type="text"]::placeholder {
                color: #999999;
                font-style: italic;
            }

            .search-wrapper input[type="text"]:focus {
                outline: none;
                border-color: #181a1b;
                box-shadow: 0 0 10px rgba(24, 26, 27, 0.3);
            }

        .search-wrapper .search-icon {
            position: absolute;
            right: 20px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 1.3rem;
            color: #999999;
            pointer-events: none;
        }
</style>

<div class="container">
    <div class="search-wrapper">
        <input type="text" id="searchInput" placeholder="Buscar productos..." />
        <span class="search-icon">🔍</span>
    </div>

    <div class="row" id="productGrid">
        @foreach (var producto in Model)
        {
            <div class="product-item" data-name="@producto.NombreArticulo.ToLower()">
                <img src="@Url.Content("~/images/" + producto.ImagenUrl)" alt="@producto.NombreArticulo" />
                <div class="product-name">@producto.NombreArticulo</div>
                <div class="product-price">₡@String.Format("{0:N0}", producto.Precio) colones</div>
                <a href="@Url.Action("Details", "Shop", new { id = producto.Id })" class="btn-vermas">Ver más</a>
            </div>
        }
    </div>
</div>

<script>
    const searchInput = document.getElementById('searchInput');
    const productItems = document.querySelectorAll('.product-item');

    searchInput.addEventListener('input', () => {
        const filter = searchInput.value.toLowerCase();
        productItems.forEach(item => {
            const name = item.getAttribute('data-name');
            item.style.display = name.includes(filter) ? '' : 'none';
        });
    });
</script>
