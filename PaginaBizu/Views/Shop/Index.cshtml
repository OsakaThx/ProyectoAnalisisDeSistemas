@{
    ViewData["Title"] = "Tienda";
}
@using System.Linq
@model IEnumerable<PaginaBizu.Models.Product>


<!-- Grilla de productos -->
<div class="container my-5">
    <div class="row">
        @foreach (var producto in Model)
        {
            <div class="col-lg-3 col-md-6 col-sm-12 mb-4">
                <div class="card product-card h-100">
                    <img src="@Url.Content("~/images/" + producto.ImagenUrl)" alt="@producto.NombreArticulo" class="card-img-top">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@producto.NombreArticulo</h5>
                        <p class="card-text">@producto.Descripcion</p>
                        <p class="precio mt-auto">₡@String.Format("{0:N0}", producto.Precio) colones</p>
                        <a href="@Url.Action("Details", "Shop", new { id = producto.Id })" class="btn btn-vermas btn-block mt-2">Ver más</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Archivos CSS y JS -->
<link rel="stylesheet" href="~/css/shop.css" />
<link href="~/css/shop.css" rel="stylesheet" />
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500&display=swap" rel="stylesheet">
<script src="~/js/site.js"></script>
<script src="~/js/shop.js"></script>
