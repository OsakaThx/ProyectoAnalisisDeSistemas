<!DOCTYPE html>
<html lang="en">
<head>
    @RenderSection("Styles", required: false)
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - PaginaBizu</title>

    <!-- Bootstrap y fuentes -->
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;500;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PaginaBizu.styles.css" asp-append-version="true" />

    <!-- Aquí enlazamos el CSS separado -->
    <link rel="stylesheet" href="~/css/gucci-style.css" />
</head>
<body>
    <!-- NAVBAR -->
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light gucci-navbar">
            <div class="container-fluid">
                <a class="navbar-brand gucci-brand" asp-area="" asp-controller="Home" asp-action="Index">PaginaBizu</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between align-items-center">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link gucci-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link gucci-link" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>

                    <!-- ICONOS DERECHO -->
                    <ul class="navbar-nav d-flex align-items-center">
                        <li class="nav-item me-4 position-relative">
                            <a class="nav-link cart-link gucci-cart-link" asp-controller="Cart" asp-action="Index" aria-label="Carrito de compras">
                                <div class="cart-icon-wrapper">
                                    <i class="bi bi-cart"></i>
                                    <span id="cart-count" class="gucci-badge">0</span>
                                </div>
                                <span>Carrito</span>
                            </a>



                        </li>

                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item dropdown">
                                <button class="btn btn-outline-dark dropdown-toggle gucci-dropdown-toggle" id="userDropdown" data-bs-toggle="dropdown"
                                        aria-expanded="false">
                                    @User.Identity.Name
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end gucci-dropdown-menu" aria-labelledby="userDropdown">
                                    <li class="dropdown-item-text gucci-dropdown-text">¿Desea cerrar sesión?</li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="dropdown-item">
                                            <button type="submit" class="btn btn-danger btn-sm w-100 gucci-logout-btn">Cerrar Sesión</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-outline-primary gucci-signin-btn" asp-controller="Account" asp-action="SignIn">Inicia Sesión</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-custom">
        <div class="container text-center">
            <small>&copy; 2025 - PaginaBizu</small>
        </div>
    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/shop.js"></script>



    <script>
        // Función para actualizar el contador del carrito al cargar la página
               
        function actualizarContadorCarrito() {
          fetch('/Cart/CartCount')
            .then(response => {
              if (!response.ok) throw new Error('Error en la respuesta');
              return response.json();
            })
            .then(count => {
              const badge = document.getElementById('cart-count');
              badge.innerText = count;
              badge.style.display = count > 0 ? 'inline-block' : 'none';
            })
            .catch(error => {
              console.error('Error al obtener el contador del carrito:', error);
            });
        }

        document.addEventListener('DOMContentLoaded', () => {
          actualizarContadorCarrito();
        });
  


        // Ejecutar al cargar la página
        document.addEventListener('DOMContentLoaded', function () {
            actualizarContadorCarrito();
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
