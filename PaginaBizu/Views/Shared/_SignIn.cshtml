@model PaginaBizu.Models.SignInModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
    /* Estilos para el contenedor del login */
    .login-container-small {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 370px;
        padding: 40px 35px 60px;
        box-sizing: border-box;
        background: #1b1b1b;
        border: 1px solid black;
        border-radius: 5px;
        box-shadow: inset 0 0 1px #272727;
        z-index: 1000;
    }

    .login-container-small .text {
        font-size: 30px;
        color: #c7c7c7;
        font-weight: 600;
        letter-spacing: 2px;
        text-align: center;
        margin-bottom: 30px;
    }

    .login-container-small form {
        margin-top: 20px;
    }

    .login-container-small .field {
        margin-top: 20px;
        display: flex;
    }

    .login-container-small .field .fas {
        height: 50px;
        width: 60px;
        color: #868686;
        font-size: 20px;
        line-height: 50px;
        border: 1px solid #444;
        border-right: none;
        border-radius: 5px 0 0 5px;
        background: #333;
        text-align: center;
    }

    .login-container-small .field input,
    .login-container-small form button {
        height: 50px;
        width: 100%;
        outline: none;
        font-size: 16px;
        color: #fff;
        padding: 0 15px;
        border-radius: 0 5px 5px 0;
        border: 1px solid #444;
        background: #333;
    }

    .login-container-small input:focus {
        color: #339933;
        box-shadow: 0 0 5px rgba(0, 255, 0, .2), inset 0 0 5px rgba(0, 255, 0, .1);
        background: #222922;
    }

    .login-container-small button {
        margin-top: 30px;
        border-radius: 5px !important;
        font-weight: 600;
        letter-spacing: 1px;
        cursor: pointer;
        background: #339933;
        border: none;
        color: #fff;
        width: 100%;
        padding: 10px 0;
        transition: all 0.3s ease;
    }

    .login-container-small button:hover {
        background: #2b7d2b;
    }

    .login-container-small .link {
        margin-top: 20px;
        text-align: center;
        color: #868686;
    }

    .login-container-small .link a {
        color: #4dabf7;
        text-decoration: none;
    }

    .login-container-small .link a:hover {
        text-decoration: underline;
    }

    /* Estilos para el modal */
    .modal {
        z-index: 9999 !important;
        display: none;
        position: fixed;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
        background-color: rgba(0, 0, 0, 0.8);
    }

    .modal.show {
        display: block;
    }

    .modal-dialog {
        position: relative;
        margin: 50px auto;
        max-width: 800px;
        z-index: 10000 !important;
    }

    .modal-backdrop {
        display: none !important;
    }

    .modal-content {
        background-color: #2c2c2c;
        color: #fff;
        border: 1px solid #444;
    }

    .modal-header {
        border-bottom: 1px solid #444;
    }

    .modal-footer {
        border-top: 1px solid #444;
    }

    .btn-close {
        filter: invert(1);
    }

    /* Estilos para el checkbox de términos */
    .form-check-input:checked {
        background-color: #339933;
        border-color: #2b7d2b;
    }

    .form-check-label {
        color: #fff !important;
    }
    
    .form-check-label a {
        color: #4dabf7 !important;
        text-decoration: none;
    }

    .form-check-label a:hover {
        text-decoration: underline;
    }

    .invalid-feedback {
        color: #ff6b6b;
        font-size: 0.875em;
        margin-top: 0.25rem;
    }
</style>

<div class="login-container-small">
    <div class="text">CREAR CUENTA</div>

    <form id="registerForm" asp-action="SignIn" asp-controller="Account" method="post" novalidate class="needs-validation">
        @Html.AntiForgeryToken()

        <!-- Email -->
        <div class="field">
            <span class="fas fa-envelope" id="icon-email"></span>
            <input asp-for="Email" placeholder="Correo electrónico" class="form-control" required />
        </div>
        <span asp-validation-for="Email" class="text-danger d-block"></span>

        <!-- Password -->
        <div class="field">
            <span class="fas fa-lock" id="icon-password"></span>
            <input asp-for="Password" type="password" placeholder="Contraseña" class="form-control" required />
        </div>
        <span asp-validation-for="Password" class="text-danger d-block"></span>

        <!-- Confirm Password -->
        <div class="field">
            <span class="fas fa-lock" id="icon-confirm-password"></span>
            <input asp-for="ConfirmPassword" type="password" placeholder="Confirmar contraseña" class="form-control" required />
        </div>
        <span asp-validation-for="ConfirmPassword" class="text-danger d-block"></span>

        <!-- Términos y condiciones -->
        <div class="form-group form-check mt-3">
            <input type="checkbox" class="form-check-input" id="termsCheck" required>
            <label class="form-check-label" for="termsCheck">
                Acepto los <a href="#" data-bs-toggle="modal" data-bs-target="#termsModal">términos y condiciones</a>
            </label>
            <div class="invalid-feedback">Debes aceptar los términos y condiciones para continuar.</div>
        </div>

        <!-- Botón -->
        <button type="submit" class="mt-3">Registrarme</button>

        <!-- Enlace -->
        <div class="link">
            ¿Ya tienes cuenta?
            <a asp-controller="Account" asp-action="Login">Iniciar sesión</a>
        </div>
    </form>
</div>

<!-- Modal Términos y Condiciones -->
<div class="modal fade" id="termsModal" tabindex="-1" aria-labelledby="termsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="termsModalLabel">Términos y Condiciones</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <h6>1. Aceptación de los Términos</h6>
                <p>Al acceder y utilizar este sitio web, aceptas estar sujeto a estos términos y condiciones de uso.</p>
                
                <h6>2. Uso del Sitio</h6>
                <p>El uso de este sitio está sujeto a las leyes y regulaciones aplicables. No podrás utilizar este sitio para ningún propósito ilegal o no autorizado.</p>
                
                <h6>3. Privacidad</h6>
                <p>Tu privacidad es importante para nosotros. Consulta nuestra Política de Privacidad para entender cómo recopilamos, usamos y protegemos tu información personal.</p>
                
                <h6>4. Propiedad Intelectual</h6>
                <p>Todo el contenido de este sitio, incluyendo textos, gráficos, logotipos, es propiedad de la empresa y está protegido por las leyes de derechos de autor.</p>
                
                <h6>5. Limitación de Responsabilidad</h6>
                <p>No seremos responsables por daños directos, indirectos, incidentales o consecuentes que resulten del uso o la imposibilidad de uso de este sitio.</p>
                
                <h6>6. Modificaciones</h6>
                <p>Nos reservamos el derecho de modificar estos términos en cualquier momento. Los cambios entrarán en vigor inmediatamente después de su publicación en el sitio.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Validación del formulario
        (function() {
            'use strict';
            var form = document.getElementById('registerForm');
            var termsCheck = document.getElementById('termsCheck');
            var termsModal = document.getElementById('termsModal');
            var closeBtn = document.querySelector('.btn-close');
            
            // Mostrar modal al hacer clic en el enlace
            document.querySelector('[data-bs-target="#termsModal"]').addEventListener('click', function(e) {
                e.preventDefault();
                termsModal.style.display = 'block';
                document.body.style.overflow = 'hidden';
            });
            
            // Cerrar modal
            function closeModal() {
                termsModal.style.display = 'none';
                document.body.style.overflow = 'auto';
            }
            
            // Cerrar al hacer clic en la X
            if (closeBtn) {
                closeBtn.addEventListener('click', closeModal);
            }
            
            // Cerrar al hacer clic fuera del modal
            window.addEventListener('click', function(e) {
                if (e.target === termsModal) {
                    closeModal();
                }
            });
            
            // Validación del formulario
            if (form && termsCheck) {
                form.addEventListener('submit', function(event) {
                    if (!termsCheck.checked) {
                        event.preventDefault();
                        event.stopPropagation();
                        termsCheck.setCustomValidity("Debes aceptar los términos y condiciones");
                        // Mostrar el modal si no se han aceptado los términos
                        termsModal.style.display = 'block';
                        document.body.style.overflow = 'hidden';
                    } else {
                        termsCheck.setCustomValidity("");
                    }
                    
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    
                    form.classList.add('was-validated');
                }, false);
            }
        })();
    </script>
}
