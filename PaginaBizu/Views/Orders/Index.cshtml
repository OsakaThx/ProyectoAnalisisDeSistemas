@model IEnumerable<PaginaBizu.Models.Order>

@{
    ViewData["Title"] = "Lista de Pedidos";
    var primerPedido = Model.FirstOrDefault();
    var isAdmin = User.IsInRole("Admin");
    
    // Función para obtener la clase CSS según el estado
    string GetStatusClass(string estado)
    {
        return estado switch
        {
            "Pendiente" => "badge bg-warning text-dark",
            "Procesando" => "badge bg-info text-dark",
            "Enviado" => "badge bg-primary",
            "Completado" => "badge bg-success",
            "Cancelado" => "badge bg-danger",
            _ => "badge bg-secondary"
        };
    }
}

<h1>Lista de Pedidos</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (isAdmin)
{
    <p>
        <a asp-controller="Orders" asp-action="CrearPedidoPrueba" class="btn btn-warning">
            Crear pedido de prueba
        </a>
    </p>
}

@if (Model.Any())
{
    <table class="table table-bordered table-striped table-hover">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(_ => primerPedido.Id)</th>
                <th>@Html.DisplayNameFor(_ => primerPedido.Fecha)</th>
                <th>@Html.DisplayNameFor(_ => primerPedido.UsuarioId)</th>
                <th>@Html.DisplayNameFor(_ => primerPedido.Estado)</th>
                <th>@Html.DisplayNameFor(_ => primerPedido.Total)</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var pedido in Model)
            {
                <tr>
                    <td>@pedido.Id</td>
                    <td>@pedido.Fecha.ToShortDateString()</td>
                    <td>@pedido.UsuarioId</td>
                    <td>
                        <span class="@GetStatusClass(pedido.Estado)">@pedido.Estado</span>
                    </td>
                    <td>@pedido.Total.ToString("C")</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@pedido.Id" class="btn btn-info btn-sm">Detalles</a>
                        <a asp-action="Edit" asp-route-id="@pedido.Id" class="btn btn-warning btn-sm">Editar</a>
                        @if (isAdmin)
                        {
                            <a asp-action="Delete" asp-route-id="@pedido.Id" class="btn btn-danger btn-sm">Eliminar</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No hay pedidos registrados.</p>
}
