@using Microsoft.AspNetCore.Identity
@inject UserManager<PaginaBizu.Models.ApplicationUser> UserManager
@inject IHttpContextAccessor HttpContextAccessor

@{
    Layout = null;
    ViewData["Title"] = "Home Page";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no" />
    <title>Home - Bizutería</title>
    <link href="~/css/style.css" rel="stylesheet" />
    <link rel="stylesheet" href="assets/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Montserrat:400,400i,700,700i,600,600i&display=swap" />
    <link rel="stylesheet" href="assets/fonts/simple-line-icons.min.css" />
    <link rel="stylesheet" href="assets/css/baguetteBox.min.css" />
    <link rel="stylesheet" href="assets/css/vanilla-zoom.min.css" />
    <style>
        .carousel-inner img {
            width: 100%;
            height: auto;
            max-height: 400px;
            object-fit: contain;
        }

        .custom-image {
            max-height: 200px;
        }
    </style>
</head>
<body>

    <!-- Navbar -->
    <nav class="navbar navbar-light navbar-expand-lg fixed-top bg-white clean-navbar">
        <div class="container">
            <a class="navbar-brand logo" href="#">Bizuteria</a>
            <button data-bs-toggle="collapse" class="navbar-toggler" data-bs-target="#navcol-1">
                <span class="visually-hidden">Toggle navigation</span>
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navcol-1">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link active" asp-controller="Shop" asp-action="Index">Shop</a>
                    </li>

                    @if (User.Identity.IsAuthenticated)
                    {
                        // Obtener el usuario actual
                        var user = await UserManager.GetUserAsync(HttpContextAccessor.HttpContext.User);

                        // Inicializar variable para saber si es admin
                        var isAdmin = false;

                        if (user != null)
                        {
                            // Obtener los roles del usuario
                            var roles = await UserManager.GetRolesAsync(user);

                            // Comprobar si tiene el rol Admin
                            isAdmin = roles.Contains("Admin");
                        }

                        // Mostrar botón extra solo si es admin
                        if (isAdmin)
                        {
                            <li class="nav-item">
                                <a class="btn btn-warning me-2" asp-controller="Products" asp-action="Index">Administrar Productos</a>
                            </li>
                        }

                        <li class="nav-item dropdown">
                            <button class="btn btn-outline-dark dropdown-toggle" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                @User.Identity.Name
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                <li class="dropdown-item-text">¿Desea cerrar sesión?</li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="dropdown-item">
                                        <button type="submit" class="btn btn-danger btn-sm w-100">Cerrar Sesión</button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="btn btn-outline-primary" asp-controller="Account" asp-action="Login">Inicia Sesión</a>

                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>


    <!-- Modal de Login -->
    <div class="modal fade" id="loginModal" tabindex="-1" aria-labelledby="loginModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content">
                <div class="modal-body">
                    <section class="form-login">
                        <h5>Formulario Login</h5>
                        <partial name="_LoginPartialUser" />
                    </section>
                </div>
            </div>
        </div>
    </div>

    <!-- MAIN CONTENT -->
    <main class="page landing-page">

        <section class="clean-block clean-hero" style="color: rgba(225,211,223,0.85);background: url('assets/img/depositphotos_5028610-stock-photo-beautiful-woman.jpg');">
            <div class="text">
                <h2>Encuentra la mejor Bizutería de Costa Rica</h2>
            </div>
        </section>

        <section class="clean-block clean-info dark">
            <div class="container">
                <div class="block-heading">
                    <h2 class="text-info"><span style="color: rgb(0, 0, 0);">Algunos de nuestros accesorios</span></h2>
                </div>
                <div class="container mt-4">
                    <!-- Producto 1 -->
                    <div class="row mb-4 align-items-center">
                        <div class="col-md-6 text-center">
                            <img src="assets/img/scenery/61-HMICpUTL._AC_UY1000_.jpg" style="max-width: 250px;" alt="Pulsera 1">
                        </div>
                        <div class="col-md-6">
                            <h5>Pulsera Dorada</h5>
                            <p>₡15,000</p>
                        </div>
                    </div>

                    <!-- Producto 2 -->
                    <div class="row mb-4 align-items-center">
                        <div class="col-md-6 text-center">
                            <img src="assets/img/scenery/66824523eb89f54aaf11e243-gold-bracelets-for-women-18k-gold-plated.jpg" style="max-width: 250px;" alt="Pulsera 2">
                        </div>
                        <div class="col-md-6">
                            <h5>Pulsera Elegante</h5>
                            <p>₡18,500</p>
                        </div>
                    </div>

                    <!-- Producto 3 -->
                    <div class="row mb-4 align-items-center">
                        <div class="col-md-6 text-center">
                            <img src="assets/img/scenery/pulsera-aine-stone-gold.jpg" style="max-width: 250px;" alt="Pulsera 3">
                        </div>
                        <div class="col-md-6">
                            <h5>Pulsera Piedra Dorada</h5>
                            <p>₡21,000</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- REDES -->
        <section class="clean-block features">
            <div class="container">
                <div class="block-heading">
                    <h2 class="text-info"><span style="color: rgb(224, 59, 178);">Encuéntranos en</span></h2>
                    <p>Costa Rica</p>
                </div>
                <div class="row text-center">
                    <div class="col-md-4 feature-box">
                        <i class="icon-social-instagram icon" style="color: rgb(224,59,178); font-size: 40px;"></i>
                        <h4><strong>Instagram</strong></h4>
                        <p>BizuCr</p>
                    </div>
                    <div class="col-md-4 feature-box">
                        <i class="icon-phone icon" style="color: rgb(224,59,178); font-size: 40px;"></i>
                        <h4><strong>Whatsapp</strong></h4>
                        <p>8402 5070</p>
                    </div>
                    <div class="col-md-4 feature-box">
                        <i class="icon-social-facebook icon" style="color: rgb(224,59,178); font-size: 40px;"></i>
                        <h4><strong>Facebook</strong></h4>
                        <p>BizuCr</p>
                    </div>
                </div>
            </div>
        </section>


        <!-- SLIDER -->
        <section class="clean-block slider dark">
            <div class="container">
                <div class="block-heading">
                    <h2 class="text-info">Slider</h2>
                </div>
                <div class="carousel slide" data-bs-ride="carousel" id="carousel-1">
                    <div class="carousel-inner">
                        <div class="carousel-item active">
                            <img class="w-100 d-block img-fluid" src="assets/img/scenery/09a84a043cf1b58d59b0e39a12c60491.jpg" alt="Slide Image">
                        </div>
                        <div class="carousel-item">
                            <img class="w-100 d-block img-fluid" src="assets/img/scenery/il_570xN.2179198790_o9bo.jpeg" alt="Slide Image">
                        </div>
                        <div class="carousel-item">
                            <img class="w-100 d-block img-fluid" src="assets/img/scenery/17001222879e9360ad6ad00d7ff0a6b62437cfbf97_thumbnail_720x.jpg" alt="Slide Image">
                        </div>
                    </div>
                    <a class="carousel-control-prev" href="#carousel-1" role="button" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon"></span>
                        <span class="visually-hidden">Previous</span>
                    </a>
                    <a class="carousel-control-next" href="#carousel-1" role="button" data-bs-slide="next">
                        <span class="carousel-control-next-icon"></span>
                        <span class="visually-hidden">Next</span>
                    </a>
                    <ol class="carousel-indicators">
                        <li data-bs-target="#carousel-1" data-bs-slide-to="0" class="active"></li>
                        <li data-bs-target="#carousel-1" data-bs-slide-to="1"></li>
                        <li data-bs-target="#carousel-1" data-bs-slide-to="2"></li>
                    </ol>
                </div>
            </div>
        </section>

        <!-- SOBRE NOSOTROS -->
        <section class="clean-block about-us">
            <div class="container">
                <div class="block-heading">
                    <h2 class="text-info">Sobre nosotros</h2>
                    <p>Nos encontramos en Costa Rica, somos una empresa nueva que quiere ofrecerte el mejor servicio.</p>
                </div>
                <div class="row justify-content-center">
                    <div class="col-sm-6 col-lg-4"><div class="card text-center clean-card"></div></div>
                    <div class="col-sm-6 col-lg-4"><div class="card text-center clean-card"></div></div>
                    <div class="col-sm-6 col-lg-4"><div class="card text-center clean-card"></div></div>
                </div>
            </div>
        </section>

    </main>

    <footer class="page-footer dark">
        <div class="footer-copyright">
            <p>© 2025 BizuCr</p>
        </div>
    </footer>

    <!-- Scripts -->
    <script>
        function cerrarModal() {
            document.getElementById('loginModal').style.display = 'none';
        }
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="assets/js/baguetteBox.min.js"></script>
    <script src="assets/js/vanilla-zoom.js"></script>
    <script src="assets/js/theme.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            @if (!User.Identity.IsAuthenticated)
            {
                    <text>
                    var loginModal = new bootstrap.Modal(document.getElementById('loginModal'));
                    loginModal.show();
                    </text>
            }
        });
    </script>

</body>
</html>
